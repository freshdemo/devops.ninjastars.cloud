source "https://rubygems.org"

# ✅ Upgrade Jekyll (4.3.x is current stable, supports Ruby 3.x)
gem "jekyll", "~> 4.3"

# ✅ Upgrade minima theme (needs at least 2.5 for Jekyll 4.x)
gem "minima", "~> 2.5"

# ✅ Core dependency for numeric handling
gem "bigdecimal"

# ✅ Ensure modern kramdown version (Jekyll 4 requires >= 2.3)
gem "kramdown", "~> 2.4"
gem "kramdown-parser-gfm"

# ✅ Platform fix (Windows only)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# ✅ Jekyll plugins
